{
  "name": "jstart",
  "version": "0.0.1",
  "description": "jstart is a lightweight launcher for Java artifacts (jar/war) written in D. It resolves an application, prepares the dependency environment by downloading missing Maven artifacts, and launches it as java with forwarded arguments.",
  "authors": ["chaostone"],
  "homepage": "https://github.com/beangle/jstart",
  "license": "GPL-3.0-or-later",
  "copyright": "Copyright (C) 2026, The Beangle Software.",
  "targetType": "executable",
  "targetName": "jstart",
  "sourcePaths": ["source"],
  "importPaths": ["source"],
  "mainSourceFile": "source/app.d",
  "configurations": [
    { "name": "application", "targetType": "executable", "targetPath": "target" },
    {
      "name": "unittest",
      "targetPath": "target",
      "sourcePaths": ["source", "test"],
      "importPaths": ["source", "test"]
    }
  ]
}
